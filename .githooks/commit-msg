#!/bin/sh
# 校验提交信息是否符合 Conventional Commits。
# 启用方式：git config core.hooksPath .githooks

set -e

commit_msg_file="$1"
header=$(head -n 1 "$commit_msg_file")

# 合并、回滚、自动修复提交直接放行
case "$header" in
    "Merge "*|"Revert "*|"revert:"*|"fixup! "*|"squash! "*)
        exit 0
        ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-zA-Z0-9._/-]+\))?!?: .{1,72}$'

if printf '%s\n' "$header" | grep -Eq "$pattern"; then
    exit 0
fi

cat >&2 <<'EOF'
提交信息不符合 Conventional Commits 规范。

格式：<type>(<scope>): <subject>
示例：feat(player): 增加 10 秒快进/快退

type：feat | fix | docs | style | refactor | perf | test | build | ci | chore
- subject 中英文均可，建议不超过 72 个字符
- 破坏性变更在 type 后加 !，并在正文注明 BREAKING CHANGE:
EOF

exit 1
