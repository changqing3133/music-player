# 默认按文本处理，仓库内统一 LF，检出时由各系统决定
* text=auto eol=lf

# Windows 脚本需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 源代码与配置
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.lrc text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
